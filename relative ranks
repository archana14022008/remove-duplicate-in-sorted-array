#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Athlete {
    int score;
    int index;
};

int compare(const void *a, const void *b) {
    struct Athlete *at1 = (struct Athlete *)a;
    struct Athlete *at2 = (struct Athlete *)b;
    return at2->score - at1->score; // Descending order
}

char** findRelativeRanks(int* score, int scoreSize, int* returnSize) {
    *returnSize = scoreSize;
    char** result = (char**)malloc(scoreSize * sizeof(char*));
    struct Athlete* athletes = (struct Athlete*)malloc(scoreSize * sizeof(struct Athlete));
    
    for (int i = 0; i < scoreSize; i++) {
        athletes[i].score = score[i];
        athletes[i].index = i;
    }
    
    qsort(athletes, scoreSize, sizeof(struct Athlete), compare);
    
    for (int i = 0; i < scoreSize; i++) {
        result[athletes[i].index] = (char*)malloc(15 * sizeof(char));
        if (i == 0) {
            strcpy(result[athletes[i].index], "Gold Medal");
        } else if (i == 1) {
            strcpy(result[athletes[i].index], "Silver Medal");
        } else if (i == 2) {
            strcpy(result[athletes[i].index], "Bronze Medal");
        } else {
            sprintf(result[athletes[i].index], "%d", i + 1);
        }
    }
    
    free(athletes);
    return result;
}
