    int maxLen = strlen(strs[0]);
    char* prefix = (char*)malloc(maxLen + 1);
    strcpy(prefix, strs[0]);

    // Iterate through the rest of the strings in the array
    for (int i = 1; i < strsSize; i++) {
        int j = 0;
        
        // Compare the current prefix with the current string character by character
        while (prefix[j] != '\0' && strs[i][j] != '\0' && prefix[j] == strs[i][j]) {
            j++;
        }
        
        // Truncate the prefix to the length of the match found
        prefix[j] = '\0';
        
        // If the prefix becomes empty, we can stop early
        if (j == 0) {
            break;
        }
    }

    return prefix;
