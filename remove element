int removeElement(int* nums, int numsSize, int val) {
    int k = 0; // Slow pointer to track the position of valid elements
    
    for (int i = 0; i < numsSize; i++) { // Fast pointer to scan the array
        if (nums[i] != val) {
            nums[k] = nums[i]; // Move valid element to the front
            k++; // Advance the valid element pointer
        }
    }
    
    return k; // Return total count of elements not equal to val
}
