#include <stdio.h>
#include <limits.h>

int maximumProduct(int* nums, int numsSize) {
    // Initialize the three largest values to minimum possible integers
    int max1 = INT_MIN, max2 = INT_MIN, max3 = INT_MIN;
    // Initialize the two smallest values to maximum possible integers
    int min1 = INT_MAX, min2 = INT_MAX;

    for (int i = 0; i < numsSize; i++) {
        int val = nums[i];

        // Update the top 3 maximum values
        if (val > max1) {
            max3 = max2;
            max2 = max1;
            max1 = val;
        } else if (val > max2) {
            max3 = max2;
            max2 = val;
        } else if (val > max3) {
            max3 = val;
        }

        // Update the top 2 minimum values
        if (val < min1) {
            min2 = min1;
            min1 = val;
        } else if (val < min2) {
            min2 = val;
        }
    }

    // Candidate 1: Product of the three largest numbers
    int prod1 = max1 * max2 * max3;
    // Candidate 2: Product of the two smallest (negative) numbers and the largest number
    int prod2 = min1 * min2 * max1;

    // Return the maximum of the two candidates
    return (prod1 > prod2) ? prod1 : prod2;
}
