int missingNumber(int* nums, int numsSize) {
    // The expected sum of numbers from 0 to n is (n * (n + 1)) / 2
    int missing = numsSize; 
    
    // Subtract each element and add the current index to avoid variable overflow
    for (int i = 0; i < numsSize; i++) {
        missing += i - nums[i];
    }
    
    return missing;
}
